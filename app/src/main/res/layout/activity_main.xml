<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_bg"
    android:padding="0dp">

    <!-- Terminal output area -->
    <ScrollView
        android:id="@+id/scrollOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="12dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/terminal_fg"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FF1A1A1A"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/prompt_user"
            android:text="unknown@ΣTerm:~Σ $ "
            android:paddingEnd="6dp" />

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:textCursorDrawable="@null"
            android:hint="@string/prompt_hint"
            android:textColorHint="#FF555555"
            android:inputType="text|textNoSuggestions"
            android:imeOptions="actionGo"
            android:maxLines="1"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
