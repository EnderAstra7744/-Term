<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_bg"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        android:scaleType="fitStart"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:src="@drawable/sigma_wordmark" />

    <ScrollView
        android:id="@+id/outputScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:background="@color/terminal_bg"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/terminal_fg"
            android:textIsSelectable="true"
            android:lineSpacingExtra="2dp"
            android:textSize="13sp" />
    </ScrollView>

    <!-- Komut satırı: siyah terminal ekranıyla aynı arka plan, kesintisiz görünüm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/terminal_bg"
        android:paddingHorizontal="10dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/promptLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/terminal_prompt"
            android:textSize="13sp"
            android:text="unknown@ΣTerm:~Σ $" />

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@null"
            android:fontFamily="monospace"
            android:hint="@string/input_hint"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/terminal_fg"
            android:textCursorDrawable="@null"
            android:textColorHint="#555555"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Termux tarzı ek tuş çubuğu: klavyenin hemen üstünde durur -->
    <LinearLayout
        android:id="@+id/extraKeysBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/key_bar_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5">

            <TextView android:id="@+id/keyEsc" style="@style/ExtraKey" android:text="ESC" />
            <TextView android:id="@+id/keyHome" style="@style/ExtraKey" android:text="HOME" />
            <TextView android:id="@+id/keyUp" style="@style/ExtraKey" android:text="↑" />
            <TextView android:id="@+id/keyEnd" style="@style/ExtraKey" android:text="END" />
            <TextView android:id="@+id/keyPgUp" style="@style/ExtraKey" android:text="PGUP" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="6">

            <TextView android:id="@+id/keyCtrl" style="@style/ExtraKey" android:text="CTRL" />
            <TextView android:id="@+id/keyAlt" style="@style/ExtraKey" android:text="ALT" />
            <TextView android:id="@+id/keyLeft" style="@style/ExtraKey" android:text="←" />
            <TextView android:id="@+id/keyDown" style="@style/ExtraKey" android:text="↓" />
            <TextView android:id="@+id/keyRight" style="@style/ExtraKey" android:text="→" />
            <TextView android:id="@+id/keyPgDn" style="@style/ExtraKey" android:text="PGDN" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
